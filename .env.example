# 1. TELEGRAM BOT CONFIG (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. TIMEZONE & DAILY REMINDER TIME (24-hour format)
TIMEZONE=Asia/Kolkata
REMINDER_HOUR=9
REMINDER_MINUTE=0

# 3. LLM BRAIN CONFIG (Works with any OpenAI-compatible API)
# --- Preset A: DeepSeek (Default, latest Flash model) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-flash

# --- Preset B: OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Preset C: Google Gemini (OpenAI-Compatible Endpoint) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_api_key
# LLM_MODEL=gemini-2.5-flash

# --- Preset D: Groq / OpenRouter / Local Ollama ---
# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (latest DeepSeek Flash):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
#
# Local Ollama (no real API key required; any non-empty value works):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# 4. VOICE TRANSCRIPTION CONFIG (For Telegram Voice Notes)
# Set STT_MODE=local to run free offline transcription via faster-whisper
# (no extra API key or system FFmpeg required).
# Set STT_MODE=api to use a cloud Whisper endpoint (Groq or OpenAI).
STT_MODE=local
LOCAL_WHISPER_MODEL=base
# Set to true to require an already-downloaded model and forbid network access.
LOCAL_WHISPER_LOCAL_FILES_ONLY=false
# You can also point LOCAL_WHISPER_MODEL at an existing model directory:
# LOCAL_WHISPER_MODEL=C:/Users/you/.cache/huggingface/hub/models--Systran--faster-whisper-base/snapshots/<snapshot-hash>

# Only required if STT_MODE=api (e.g., free Groq Whisper or OpenAI Whisper)
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=your_groq_or_openai_api_key
STT_MODEL=whisper-large-v3-turbo
